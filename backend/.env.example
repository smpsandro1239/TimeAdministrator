# Configuração local — preencher antes de executar.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# MongoDB local. Para Atlas, usar a URI fornecida no painel do cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/timeadministrator
MONGO_INITDB_ROOT_USERNAME=CHANGE_ME
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# JWT — gerar um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# Credenciais de criação inicial do administrador (não usar valores de exemplo em produção).
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@example.invalid

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Stripe — usar chaves de teste apenas em desenvolvimento.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Logging
LOG_LEVEL=info
